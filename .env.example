# =============================================================================
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# ---------- Supabase ---------------------------------------------------------
# Find these in the Supabase dashboard under Settings → API.
# - URL is the project's `https://<ref>.supabase.co` endpoint.
# - SUPABASE_ANON_KEY is the public anon key (safe to expose in the browser).
# - SUPABASE_SERVICE_ROLE_KEY is the secret service-role key (server-only).
# - SUPABASE_JWT_SECRET is the JWT signing secret used to verify user tokens
#   on the backend (Settings → API → JWT Secret).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Frontend reads `import.meta.env.VITE_*`. Mirror the values above:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: explicit backend base URL for the frontend. Leave blank in dev
# (Vite proxies /api → http://127.0.0.1:8000). Set this for production.
VITE_API_BASE_URL=

# ---------- Strava -----------------------------------------------------------
# Create the app at https://www.strava.com/settings/api.
# Note: new Strava apps start in Single Player Mode (1-athlete cap, grows
# automatically as athletes authenticate).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/api/oauth/strava/callback

# ---------- Whoop ------------------------------------------------------------
# Create the app at https://developer.whoop.com.
# Required scopes: read:recovery read:sleep read:workout read:cycles
#                  read:profile offline   ← `offline` MUST be present.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8000/api/oauth/whoop/callback

# ---------- Mapbox -----------------------------------------------------------
# Public token from https://account.mapbox.com — restrict it to your domain.
VITE_MAPBOX_TOKEN=

# ---------- Backend security -------------------------------------------------
# Fernet key for encrypting Strava/Whoop tokens at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Public origin of the frontend (no trailing slash). Used by the OAuth callbacks
# to redirect the browser back after Strava / Whoop authorize.
FRONTEND_URL=http://localhost:5173

# Comma-separated origins allowed by FastAPI CORS. Add the prod URL when you
# deploy the frontend.
CORS_ORIGINS=http://localhost:5173
